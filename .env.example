# Copy to .env and fill in. .env is git-ignored (NFR-01). Never commit real keys.

# --- Model provider: Google Gemini is the ONLY approved provider ---
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
# low | medium | high  (Gemini thinking level used by the agents)
GEMINI_THINKING_LEVEL=low

# Set to 1 to guarantee ZERO Gemini calls (deterministic fallbacks), even if a key is present
COPILOT_FORCE_OFFLINE=0

# --- Resilience (NFR-04) ---
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3
# client-side rate limiting (free-tier keys: set LLM_RPM to your per-minute quota)
LLM_MAX_CONCURRENCY=4
LLM_RPM=0
TOOL_TIMEOUT_S=20
MAX_STEPS=12
RECURSION_LIMIT=40

# --- Cost governance (USD per 1M tokens; PLACEHOLDER prices - check current Gemini pricing before paid runs) ---
PRICE_INPUT_PER_1M=0.30
PRICE_OUTPUT_PER_1M=2.50
COST_BUDGET_PER_RUN_USD=0.05

# --- Observability ---
PHOENIX_PORT=6006
PHOENIX_PROJECT=claims-fraud-copilot
TRACING_ENABLED=true

# --- Privacy: salt for deterministic pseudonymisation of identifiers in logs ---
PII_HASH_SALT=change-me-local-salt
